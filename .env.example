# Plantilla del entorno local. Copiar a .env (que está ignorado por Git) y cambiar las contraseñas.
# Estos valores son SOLO para desarrollo en tu máquina; nunca usar los de producción acá.

# PostgreSQL 18
# POSTGRES_USER es el dueño de la base: corre las migraciones. La API usa el rol tallercontrol_app,
# que no puede borrar filas ni modificar la auditoría. scripts/dev.ps1 lo crea y, si falta
# POSTGRES_APP_PASSWORD, genera una clave y la agrega a tu .env.
POSTGRES_USER=tallercontrol
POSTGRES_PASSWORD=cambiar-esta-clave-local
POSTGRES_DB=tallercontrol
POSTGRES_PORT=5432
POSTGRES_APP_PASSWORD=cambiar-esta-clave-de-la-app

# Almacenamiento S3 local (sustituto de Cloudflare R2)
STORAGE_ACCESS_KEY=tcdevaccess
STORAGE_SECRET_KEY=cambiar-esta-clave-local-12345
STORAGE_BUCKET=tallercontrol-dev
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Cloudflare Turnstile (validación anti-bot en el portal QR público)
# La clave 1x0000000000000000000000000000000AA siempre pasa; usar solo para tests locales.
QR_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
QR_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Avisos push al celular del mecánico (N-04). Se generan con: .\scripts\generate-vapid-keys.ps1 -WriteEnv
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# PUSH_SUBJECT=mailto:soporte@tallercontrol.com.ar
